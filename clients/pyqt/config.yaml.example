# Telegram User API (from https://my.telegram.org)
telegram:
  api_id: YOUR_API_ID
  api_hash: "YOUR_API_HASH"

# Database connection
database:
  host: "localhost"
  port: 5432
  user: "sticker"
  password: "sticker"
  dbname: "sticker"

# Global hotkey to show search window
hotkey: "<ctrl>+<shift>+s"

# Your Telegram user ID (get from @userinfobot)
user_id: YOUR_USER_ID
